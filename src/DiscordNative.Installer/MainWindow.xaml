<Window
    x:Class="DiscordNative.Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titre & Logo -->
        <StackPanel Grid.Row="0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="48" Height="48" Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="14">
                    <FontIcon Glyph="&#xE8FA;" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Installation de DiscordNative" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Client Discord natif WinUI 3 et C# (.NET 8)" FontSize="13" Opacity="0.6" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Options d'installation -->
        <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Dossier d'installation :" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="InstallPathBox" CornerRadius="8" IsReadOnly="False" />
                        <Button Grid.Column="1" Content="Parcourir..." Click="OnBrowseClicked" CornerRadius="8" />
                    </Grid>

                    <CheckBox x:Name="DesktopShortcutCheck" Content="Créer un raccourci sur le Bureau" IsChecked="True" />
                    <CheckBox x:Name="StartMenuCheck" Content="Ajouter au Menu Démarrer" IsChecked="True" />
                </StackPanel>
            </Border>

            <ProgressBar x:Name="InstallProgress" IsIndeterminate="True" Visibility="Collapsed" Height="6" CornerRadius="3" />
            <TextBlock x:Name="StatusText" Text="" Opacity="0.8" HorizontalAlignment="Center" FontSize="13" />
        </StackPanel>

        <!-- Boutons d'action -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="v0.2.0 • Propulsé par WinUI 3" VerticalAlignment="Center" Opacity="0.5" FontSize="11" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Content="Annuler" Click="OnCancelClicked" CornerRadius="8" />
                <Button x:Name="InstallButton" Content="Installer maintenant" Click="OnInstallClicked" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
