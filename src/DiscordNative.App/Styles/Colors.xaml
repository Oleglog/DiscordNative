<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette inspirée du blurple Discord, réutilisable comme AccentColor personnalisé -->
    <Color x:Key="DiscordBlurpleColor">#5865F2</Color>
    <Color x:Key="DiscordGreenColor">#23A55A</Color>
    <Color x:Key="DiscordRedColor">#F23F42</Color>
    <Color x:Key="DiscordYellowColor">#F0B232</Color>

    <SolidColorBrush x:Key="DiscordBlurpleBrush" Color="{StaticResource DiscordBlurpleColor}" />

</ResourceDictionary>
