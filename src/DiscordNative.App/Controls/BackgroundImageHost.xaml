<UserControl
    x:Class="DiscordNative.App.Controls.BackgroundImageHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Image de fond fournie par l'utilisateur, façon "Custom background" de Files -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" />

        <!-- Voile d'assombrissement/flou par-dessus pour garder le texte lisible -->
        <Grid x:Name="OverlayGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    </Grid>
</UserControl>
