<UserControl
    x:Class="DiscordNative.App.Views.MainWindowContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DiscordNative.Protocol.Models"
    xmlns:controls="using:DiscordNative.App.Controls">

    <Grid>
        <controls:BackgroundImageHost x:Name="BackgroundHost" />

        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" />

            <!-- Bannière de notification de mise à jour WinUI 3 InfoBar -->
            <InfoBar Grid.Row="1" x:Name="UpdateInfoBar"
                     IsOpen="False"
                     Severity="Informational"
                     Title="Mise à jour disponible"
                     Message="Une nouvelle version de DiscordNative est prête !"
                     CornerRadius="8"
                     Margin="12,0,12,8">
                <InfoBar.ActionButton>
                    <Button Content="Télécharger" Click="OnDownloadUpdateClicked" Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 0. Liste des serveurs -->
                <Grid Grid.Column="0" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Margin="12,12,12,4" Width="48" Height="48" CornerRadius="16"
                            Click="OnFriendsClicked" ToolTipService.ToolTip="Amis et messages privés">
                        <FontIcon Glyph="&#xE8FA;" />
                    </Button>

                    <ListView Grid.Row="1" x:Name="GuildList"
                              ItemsSource="{x:Bind ViewModel.Guilds, Mode=OneWay}"
                              SelectionMode="Single"
                              SelectionChanged="OnGuildSelected"
                              Padding="8,4,8,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiscordGuild">
                                <Grid Width="48" Height="48" Margin="0,0,0,8" ToolTipService.ToolTip="{x:Bind Name}">
                                    <Rectangle Fill="{ThemeResource ControlFillColorSecondaryBrush}" RadiusX="16" RadiusY="16" />
                                    <Rectangle RadiusX="16" RadiusY="16" Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center"
                                               Visibility="{x:Bind ShowInitials, Converter={StaticResource BoolToVisibilityConverter}}"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="2" Margin="12" Width="48" Height="48" CornerRadius="16"
                            Click="OnSettingsClicked" ToolTipService.ToolTip="Paramètres">
                        <FontIcon Glyph="&#xE713;" />
                    </Button>
                </Grid>

                <!-- 1. Salons & DM -->
                <Grid Grid.Column="1" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Haut gauche : Titre de serveur & Recherche de salons (Quick Switcher) -->
                    <StackPanel Grid.Row="0" Margin="12,10,12,10" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SelectedGuildName, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="ChannelSearchBox"
                                 PlaceholderText="Rechercher un salon..."
                                 CornerRadius="8"
                                 FontSize="12"
                                 Height="32"
                                 Padding="10,4"
                                 BorderThickness="0"
                                 Background="{ThemeResource ControlFillColorDefaultBrush}"
                                 TextChanged="OnChannelSearchChanged"
                                 Visibility="{x:Bind ViewModel.ShowingGuildChannels, Mode=OneWay}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListView x:Name="ChannelList"
                                  ItemsSource="{x:Bind ViewModel.FilteredChannels, Mode=OneWay}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnChannelSelected"
                                  Visibility="{x:Bind ViewModel.ShowingGuildChannels, Mode=OneWay}"
                                  Padding="8,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiscordChannel">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6">
                                        <FontIcon Glyph="{x:Bind Type, Converter={StaticResource ChannelTypeToGlyphConverter}}"
                                                  FontSize="14" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ScrollViewer Visibility="{x:Bind ViewModel.ShowingFriendsView, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Text="Messages privés" Margin="12,12,12,4" Opacity="0.6" FontSize="12" FontWeight="SemiBold" />
                                <ListView x:Name="PrivateChannelList"
                                          ItemsSource="{x:Bind ViewModel.PrivateChannels, Mode=OneWay}"
                                          SelectionMode="Single"
                                          SelectionChanged="OnChannelSelected"
                                          Padding="8,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordChannel">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6">
                                                <Grid Width="28" Height="28">
                                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Text="Amis" Margin="12,16,12,4" Opacity="0.6" FontSize="12" FontWeight="SemiBold" />
                                <ListView x:Name="FriendList"
                                          ItemsSource="{x:Bind ViewModel.Friends, Mode=OneWay}"
                                          SelectionMode="None"
                                          Padding="8,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordRelationship">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6">
                                                <Grid Width="28" Height="28">
                                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind User.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock Text="{x:Bind User.DisplayName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bas gauche : Panneau Vocal & Profil -->
                    <StackPanel Grid.Row="2" Background="Transparent">
                        <!-- Statut de connexion vocal actif -->
                        <Grid Padding="12,8" Background="#1B7A43" CornerRadius="12" Margin="8,0,8,6"
                              Visibility="{x:Bind ViewModel.IsVoiceConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE803;" FontSize="18" Foreground="White" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Voice Connected" FontWeight="Bold" FontSize="12" Foreground="White" />
                                    <TextBlock Text="{x:Bind ViewModel.ConnectedVoiceChannelName, Mode=OneWay}" FontSize="11" Foreground="White" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Width="32" Height="32" CornerRadius="16" Padding="0" Background="#33FFFFFF" BorderThickness="0" Click="OnDisconnectVoiceClicked" ToolTipService.ToolTip="Se déconnecter">
                                <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="White" />
                            </Button>
                        </Grid>

                        <!-- Barre Profil Utilisateur & Contrôles Audio Mute/Deafen/Settings -->
                        <Grid Height="56" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="8,0,8,8" CornerRadius="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Profil & Statut Sélecteur -->
                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="En ligne" Click="OnStatusOnlineClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF136;" Foreground="#23A55A" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Inactif" Click="OnStatusIdleClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF136;" Foreground="#F0B232" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Ne pas déranger" Click="OnStatusDndClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF136;" Foreground="#F23F43" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Invisible" Click="OnStatusInvisibleClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF136;" Foreground="#80848E" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Grid Width="34" Height="34">
                                        <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserAvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- Pastille d'état Discord -->
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.StatusDotColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                                 Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentStatus, Mode=OneWay}"
                                                   FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Boutons Audio Mute / Deafen -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleMuteClicked" ToolTipService.ToolTip="Couper/Activer le micro">
                                    <FontIcon Glyph="&#xE720;" FontSize="14" Opacity="{x:Bind ViewModel.IsMuted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Button>
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleDeafenClicked" ToolTipService.ToolTip="Mettre en sourdine">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 2. Zone principale : Chat OU Vue Vocale interactive -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- En-tête de salon -->
                    <Border Grid.Row="0" Background="Transparent"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
                            <FontIcon Glyph="&#xE803;" FontSize="16" Opacity="0.6" Visibility="{x:Bind ViewModel.VoiceViewVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedChannelName, Mode=OneWay}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- VUE VOCALE (Grille de participants comme le vrai Discord) -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.VoiceViewVisibility, Mode=OneWay}" Padding="20">
                        <GridView ItemsSource="{x:Bind ViewModel.VoiceParticipants, Mode=OneWay}" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiscordUser">
                                    <Border Width="260" Height="190" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="16" Margin="10">
                                        <Grid>
                                            <Ellipse Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <!-- Nom du participant en bas à gauche de la carte -->
                                            <Border Background="#66000000" CornerRadius="8" Padding="8,4"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
                                                <TextBlock Text="{x:Bind DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <!-- VUE TEXTUELLE (Messages classiques) -->
                    <ListView Grid.Row="1" x:Name="MessageList"
                              Visibility="{x:Bind ViewModel.TextViewVisibility, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                              Padding="16,8"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiscordMessage">
                                <StackPanel Margin="0,2,0,6" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,4"
                                                Visibility="{x:Bind ShowHeader, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- Bouton avatar avec Popout Profil ultra détaillé façon Discord -->
                                        <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="20" VerticalAlignment="Top">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="CornerRadius" Value="16" />
                                                            <Setter Property="MaxWidth" Value="320" />
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <Grid Width="300" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                        <!-- Bannière -->
                                                        <Border Height="90" Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="16,16,0,0">
                                                            <Image Source="{x:Bind Author.BannerUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Visibility="{x:Bind Author.HasBanner, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>

                                                        <!-- Avatar rond avec bordure épaisse qui chevauche la bannière -->
                                                        <Ellipse Width="80" Height="80" Margin="16,48,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                 StrokeThickness="6" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>

                                                        <!-- Corps du profil -->
                                                        <StackPanel Margin="16,134,16,16" Spacing="8">
                                                            <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="Bold" FontSize="20" />
                                                            <TextBlock Text="{x:Bind Author.UserTag}" Opacity="0.6" FontSize="13" />

                                                            <!-- Badges / Statut -->
                                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8,4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="Goldenrod" />
                                                                    <TextBlock Text="Utilisateur Discord Native" FontSize="11" Opacity="0.8" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Séparateur -->
                                                            <MenuFlyoutSeparator Margin="0,4" />

                                                            <TextBlock Text="À PROPOS DE MOI" FontSize="11" FontWeight="Bold" Opacity="0.6" />
                                                            <TextBlock Text="Grand voyageur de salons Discord." FontSize="13" TextWrapping="Wrap" Opacity="0.9" />

                                                            <!-- Champ de message direct -->
                                                            <TextBox PlaceholderText="Envoyer un message..." CornerRadius="8" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Flyout>
                                            </Button.Flyout>

                                            <!-- L'avatar affiché dans le message (cercle parfait) -->
                                            <Grid Width="40" Height="40">
                                                <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{x:Bind ShortTime}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Message Système -->
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind IsSystem, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="8" Margin="0,4">
                                        <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind SystemText}" FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Texte du message -->
                                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" Margin="50,0,0,0"
                                               Visibility="{x:Bind IsNormal, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- Pièces jointes Images -->
                                    <ItemsControl ItemsSource="{x:Bind ImageAttachments}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordAttachment">
                                                <Border CornerRadius="8">
                                                    <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                           MaxWidth="400" MaxHeight="300" HorizontalAlignment="Left" Margin="0,4" Stretch="Uniform" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Embeds -->
                                    <ItemsControl ItemsSource="{x:Bind Embeds}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasEmbeds, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordEmbed">
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4" MaxWidth="400" HorizontalAlignment="Left">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Provider.Name}" FontSize="12" Opacity="0.6" Visibility="{x:Bind HasProvider, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{x:Bind HasTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{x:Bind Description}" FontSize="12" TextWrapping="Wrap" Opacity="0.8" Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Image Source="{x:Bind MainImageUrl, Converter={StaticResource StringToImageSourceConverter}}" MaxWidth="400" MaxHeight="300" Margin="0,8,0,0" Stretch="Uniform" Visibility="{x:Bind HasMainImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Réactions sous le message -->
                                    <ItemsControl ItemsSource="{x:Bind Reactions}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasReactions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordReaction">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="6,3">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{x:Bind EmojiText}" FontSize="13" />
                                                        <TextBlock Text="{x:Bind CountText}" FontSize="11" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Barre de saisie de message (visible seulement en mode texte) -->
                    <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.TextViewVisibility, Mode=OneWay}" Padding="16,0,16,16" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="40" Height="40" CornerRadius="20" Padding="0"
                                Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                Click="OnAttachFileClicked" ToolTipService.ToolTip="Joindre un fichier ou une image">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                        </Button>
                        <TextBox Grid.Column="1" x:Name="MessageInput"
                                 PlaceholderText="Écrire un message..."
                                 CornerRadius="10" BorderThickness="0"
                                 Background="{ThemeResource ControlFillColorDefaultBrush}"
                                 Padding="14,10"
                                 KeyDown="OnMessageInputKeyDown" />
                        <Button Grid.Column="2" Content="Envoyer" Click="OnSendClicked"
                                CornerRadius="10"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <!-- Barre de contrôles vocal en bas si on est dans un vocal -->
                    <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.VoiceViewVisibility, Mode=OneWay}" Padding="16,0,16,16">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16" Padding="12,8" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Button Width="40" Height="40" CornerRadius="20" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        Click="OnToggleMuteClicked" ToolTipService.ToolTip="Muet">
                                    <FontIcon Glyph="&#xE720;" FontSize="16" />
                                </Button>
                                <Button Width="40" Height="40" CornerRadius="20" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        Click="OnToggleDeafenClicked" ToolTipService.ToolTip="Casque">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="16" />
                                </Button>
                                <Button Width="48" Height="40" CornerRadius="20" Background="#E02424" Foreground="White" Click="OnDisconnectVoiceClicked" ToolTipService.ToolTip="Déconnexion">
                                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
