<Window
    x:Class="DiscordNative.App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Zone de titre custom pour garder un look natif épuré -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="360" Spacing="16">

            <TextBlock Text="Connexion à Discord" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />

            <!-- Étape 1 : email / mot de passe -->
            <StackPanel x:Name="CredentialsPanel" Spacing="12">
                <TextBox x:Name="EmailBox" PlaceholderText="E-mail ou numéro de téléphone"
                         Header="Adresse e-mail" />
                <PasswordBox x:Name="PasswordBox" PlaceholderText="Mot de passe"
                             Header="Mot de passe" />
                <Button x:Name="LoginButton" Content="Se connecter" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}" Click="OnLoginClicked" />
            </StackPanel>

            <!-- Étape 2 : code 2FA, masquée par défaut -->
            <StackPanel x:Name="MfaPanel" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="Vérification en deux étapes" FontWeight="SemiBold" />
                <TextBox x:Name="MfaCodeBox" PlaceholderText="Code à 6 chiffres"
                         Header="Code de votre application d'authentification"
                         MaxLength="6" InputScope="Number" />
                <Button x:Name="MfaButton" Content="Valider" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}" Click="OnMfaClicked" />
            </StackPanel>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24"
                          HorizontalAlignment="Center" />

            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Title="Erreur" />

            <TextBlock Text="Client non officiel, non affilié à Discord Inc. L'usage de ce client peut enfreindre les conditions d'utilisation de Discord."
                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</Window>
